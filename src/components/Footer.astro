---
import GitHubIcon from "@components/icons/GitHub.astro";
import LinkedInIcon from "@components/icons/LinkedIn.astro";
import MailIcon from "@components/icons/Mail.astro";
import { geti18n } from "@i18n/index";
const { currentLocale } = Astro;
const i18n = geti18n({ currentLocale });
const links = [
  { href: "https://github.com/cristiand395", label: "GitHub", Icon: GitHubIcon },
  { href: "https://www.linkedin.com/in/cristiand395/", label: "LinkedIn", Icon: LinkedInIcon },
  { href: "mailto:cristiand395@gmail.com", label: "cristiand395@gmail.com", Icon: MailIcon },
];
---

<!-- Cierre con la paleta invertida, como la última slide de la serie: «a partir de ahora». -->
<footer id="contacto" class="bg-ink px-4 pt-20 pb-32 text-white md:px-16">
  <div class="mx-auto w-full max-w-6xl">
    <p class="mb-4 font-mono text-sm text-[#aab3c8]">{i18n.CONTACT.EYEBROW}</p>
    <h2 class="mb-10 text-4xl leading-tight font-black tracking-[-0.03em] md:text-6xl">
      {i18n.CONTACT.TITLE} <span class="hl">{i18n.CONTACT.HIGHLIGHT}</span>
    </h2>
    <ul class="flex flex-wrap gap-3">
      {
        links.map(({ href, label, Icon }) => (
          <li>
            <a
              href={href}
              target={href.startsWith("http") ? "_blank" : undefined}
              rel="noopener noreferrer"
              class="flex min-h-11 items-center gap-2 rounded-full border-2 border-white px-5 py-2.5 font-mono text-sm transition hover:bg-white hover:text-ink"
            >
              <Icon class="size-5" />
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
