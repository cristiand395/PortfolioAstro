---
/**
 * Riel de la serie «pasos»: hecho en tinta, actual en naranja, pendiente hueco.
 * - banner: estático, igual que la portada de LinkedIn (paso actual fijo).
 * - interactivo: cada nodo es un enlace a su paso; el script de Metodo marca el actual.
 */
interface Props {
  labels: string[];
  current: number;
  interactive?: boolean;
  label: string;
}
const { labels, current, interactive = false, label } = Astro.props;
const last = labels.length - 1;
---

<nav class:list={["rail", { "rail-interactive": interactive }]} aria-label={label} data-rail>
  <div class="rail-track"></div>
  <div class="rail-fill" style={`--fill: ${current / last}`}></div>
  <ol>
    {
      labels.map((text, i) => {
        const state = i < current ? "done" : i === current ? "current" : "pending";
        const content = (
          <>
            <span class="rail-dot" />
            <span class="rail-label">{text}</span>
          </>
        );
        return (
          <li class="rail-node" data-state={state} style={`--x: ${(i / last) * 100}%; --i: ${i}`}>
            {interactive ? (
              <a href={`#paso-${i}`} aria-current={i === current ? "step" : undefined}>
                {content}
              </a>
            ) : (
              <span>{content}</span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .rail {
    position: relative;
    height: 4.5rem;
  }
  .rail-track,
  .rail-fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 13px;
    height: 4px;
    border-radius: 2px;
    background: var(--color-rail);
  }
  .rail-fill {
    background: var(--color-ink);
    transform-origin: left;
    scale: var(--fill) 1;
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rail-node {
    position: absolute;
    top: 0;
    left: var(--x);
    translate: -50% 0;
  }
  .rail-node > * {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-muted);
    text-decoration: none;
  }
  .rail-dot {
    width: 30px;
    height: 30px;
    box-sizing: border-box;
    border-radius: 50%;
    border: 4px solid var(--color-rail);
    background: var(--color-sand);
    transition:
      background 0.3s,
      border-color 0.3s,
      scale 0.3s;
  }
  [data-state="done"] .rail-dot {
    border-color: var(--color-ink);
    background: var(--color-ink);
  }
  [data-state="current"] .rail-dot {
    border: 5px solid var(--color-ink);
    background: var(--color-ember);
    scale: 1.33;
  }
  [data-state="current"] .rail-label {
    color: var(--color-ink);
    font-weight: 800;
  }
  .rail-label {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .rail-interactive a:hover .rail-dot {
    border-color: var(--color-ember);
  }
  /* En móvil no caben las cinco etiquetas: solo se lee la del paso actual. */
  @media (max-width: 767px) {
    .rail-label {
      display: none;
    }
    [data-state="current"] .rail-label {
      display: block;
    }
  }

  /* Banner: al cargar, la línea crece y los nodos aparecen uno a uno, como si se rellenara el riel. */
  .rail:not(.rail-interactive) .rail-fill {
    animation: rail-grow 0.9s 0.2s ease-out both;
  }
  .rail:not(.rail-interactive) .rail-dot {
    animation: rail-pop 0.4s calc(0.2s + var(--i) * 0.15s) ease-out both;
  }
  @keyframes rail-grow {
    from {
      scale: 0 1;
    }
  }
  @keyframes rail-pop {
    from {
      opacity: 0;
      scale: 0.4;
    }
  }

  /* Riel interactivo: la línea avanza con el scroll de la sección del método, sin JavaScript. */
  @supports (animation-timeline: view()) {
    .rail-interactive .rail-fill {
      scale: 0 1;
      animation: rail-scroll linear both;
      animation-timeline: --metodo;
      animation-range: contain 0% contain 100%;
    }
  }
  @keyframes rail-scroll {
    to {
      scale: 1 1;
    }
  }
</style>
