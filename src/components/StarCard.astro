---
interface Props {
  titulo: string;
  texto: string;
  cifra?: string;
  enlace?: string;
  brillo: number;
  typeLabel: string;
  linkLabel: string;
}
const { titulo, texto, cifra, enlace, brillo, typeLabel, linkLabel } = Astro.props;
// Tarjeta de la serie: blanca con borde de tinta. La barra inferior refleja cuánto pesa (brillo 1 a 3).
---

<article class="flex h-full flex-col gap-3 rounded-2xl border-4 border-ink bg-white p-7">
  <p class="font-mono text-sm text-muted">{typeLabel}</p>
  <h3 class="text-2xl font-black tracking-[-0.02em]">{titulo}</h3>
  <p class="leading-relaxed text-muted">{texto}</p>
  {cifra && <p class="font-mono text-sm font-extrabold text-plus">+ {cifra}</p>}
  {
    enlace && (
      <a
        href={enlace}
        target="_blank"
        rel="noopener noreferrer"
        class="self-start py-2 font-bold underline decoration-ember decoration-2 underline-offset-4"
      >
        {linkLabel} ↗
      </a>
    )
  }
  <div class="mt-auto h-3 rounded-full bg-ink" style={`width: ${30 + brillo * 20}%`}></div>
</article>
