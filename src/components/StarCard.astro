---
interface Props {
  titulo: string;
  texto: string;
  cifra?: string;
  enlace?: string;
  typeLabel: string;
  linkLabel: string;
  color: string;
}
const { titulo, texto, cifra, enlace, typeLabel, linkLabel, color } = Astro.props;
---

<article
  class="flex h-full flex-col gap-3 rounded-2xl border border-white/10 bg-[#100e1a] p-6"
  style={`--accent: ${color}`}
>
  <div class="flex items-start justify-between gap-4">
    <p class="font-mono text-xs tracking-wider text-(--accent) uppercase">
      {typeLabel}
    </p>
    <slot name="actions" />
  </div>
  <h3 class="text-xl font-bold">{titulo}</h3>
  <p class="leading-relaxed text-muted">{texto}</p>
  {cifra && <p class="font-mono text-sm text-paper">{cifra}</p>}
  {
    enlace && (
      <a
        href={enlace}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-auto self-start py-2 text-(--accent) underline-offset-4 hover:underline"
      >
        {linkLabel} ↗
      </a>
    )
  }
</article>
