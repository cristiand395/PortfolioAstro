---
import StarCard from "@components/StarCard.astro";
import { loadSky } from "../sky";

const { i18n, constellations, stars } = await loadSky(Astro.currentLocale);
const eyebrow = i18n.HERO.EYEBROW.replace("{stars}", String(stars.length)).replace(
  "{constellations}",
  String(constellations.length),
);
---

<section id="grafo" class="relative">
  <div class="graph fixed inset-0 -z-10 overflow-hidden" data-graph>
    <canvas class="absolute inset-0 size-full" aria-hidden="true"></canvas>
    <ul class="constellation-labels" aria-hidden="true">
      {
        constellations.map((c) => (
          <li data-constellation-label style={`color: ${c.color}`}>
            {c.name}
          </li>
        ))
      }
    </ul>
    <ul class="star-labels" aria-label={i18n.MENU.SKY}>
      {
        stars.map((s) => (
          <li
            data-star
            data-constellation={s.constellationIndex}
            data-brightness={s.brillo}
            data-color={s.color}
          >
            <button
              type="button"
              popovertarget={`star-${s.id}`}
              class="label"
              style={`--accent: ${s.color}`}
            >
              {s.titulo}
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  {
    stars.map((s) => (
      <div popover id={`star-${s.id}`} class="star-popover">
        <StarCard
          {...s}
          typeLabel={i18n.SKY.TYPES[s.tipo]}
          linkLabel={i18n.SKY.LINK}
        >
          <button
            slot="actions"
            type="button"
            popovertarget={`star-${s.id}`}
            popovertargetaction="hide"
            aria-label={i18n.SKY.CLOSE}
            class="-m-2 grid size-11 place-items-center rounded-full text-muted hover:bg-white/10 hover:text-paper"
          >
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </StarCard>
      </div>
    ))
  }

  <div class="pointer-events-none relative">
    <article class="step flex min-h-svh items-center px-4 md:px-16">
      <div class="mx-auto w-full max-w-7xl">
        <div
          class="flex max-w-xl flex-col gap-6 rounded-2xl bg-ink/75 p-6 backdrop-blur md:bg-transparent md:p-0 md:backdrop-blur-none"
        >
          <p class="font-mono text-sm text-violet">
            <span class="text-ember" aria-hidden="true">●</span>
            {eyebrow}
          </p>
          <h1 class="text-5xl leading-none font-bold tracking-tight md:text-7xl">
            {i18n.HERO.TITLE}
          </h1>
          <p class="text-lg leading-relaxed text-muted md:text-xl">
            {i18n.HERO.DESCRIPTION}
          </p>
          <a
            href="#tour-0"
            class="self-start rounded-full bg-ember px-6 py-3.5 font-bold text-ink transition hover:bg-paper"
          >
            {i18n.HERO.CTA}
          </a>
        </div>
      </div>
    </article>

    {
      constellations.map((c, index) => (
        <article
          id={`tour-${index}`}
          class="step flex min-h-svh items-end px-4 pb-28 md:items-center md:px-16 md:pb-0"
        >
          <div class="mx-auto w-full max-w-7xl">
            <div class="max-w-md rounded-2xl border border-white/10 bg-ink/70 p-8 backdrop-blur">
              <p class="mb-3 font-mono text-sm" style={`color: ${c.color}`}>
                {c.stars.length} ★
              </p>
              <h2 class="mb-4 text-3xl font-bold tracking-tight">{c.name}</h2>
              <p class="leading-relaxed text-muted">{c.text}</p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* Sin WebGL no hay etiquetas flotantes: la sección Constelaciones ya lista todas las estrellas. */
  .star-labels,
  .constellation-labels {
    display: none;
  }
  .graph-ready .star-labels,
  .graph-ready .constellation-labels {
    display: block;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .graph-ready li {
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.3s;
  }
  .graph-ready .star-labels li {
    margin: 12px 0 0 12px;
  }
  .graph-ready .constellation-labels li {
    translate: -50% 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.8;
    white-space: nowrap;
  }
  .label {
    pointer-events: auto;
    cursor: pointer;
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    font-size: 0.8rem;
    white-space: nowrap;
    color: var(--color-paper);
    background: rgb(7 7 11 / 0.55);
    border: 1px solid color-mix(in oklch, var(--accent) 45%, transparent);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .label:hover,
  .label:focus-visible {
    background: var(--accent);
    color: var(--color-ink);
  }

  /* Tarjeta de cada estrella: Popover API nativa, con entrada animada vía @starting-style. */
  .star-popover {
    margin: auto;
    width: min(28rem, calc(100vw - 2rem));
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    opacity: 0;
    translate: 0 16px;
    transition:
      opacity 0.25s,
      translate 0.25s,
      overlay 0.25s allow-discrete,
      display 0.25s allow-discrete;
  }
  .star-popover:popover-open {
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .star-popover:popover-open {
      opacity: 0;
      translate: 0 16px;
    }
  }
  .star-popover::backdrop {
    background: rgb(7 7 11 / 0.55);
    backdrop-filter: blur(4px);
  }

  /* Los pasos van encima del cielo: dejan pasar los clics a las estrellas salvo en su tarjeta. */
  .step {
    pointer-events: none;
  }
  .step > div > * {
    pointer-events: auto;
  }

  /* Cada paso entra y sale con su propio avance en pantalla: animation-timeline: view(). */
  @supports (animation-timeline: view()) {
    .step > div {
      animation: step-cross linear both;
      animation-timeline: view();
      animation-range: cover 0% cover 100%;
    }
  }
  @keyframes step-cross {
    0% {
      opacity: 0;
      translate: 0 80px;
    }
    35%,
    65% {
      opacity: 1;
      translate: 0 0;
    }
    100% {
      opacity: 0;
      translate: 0 -80px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-graph]");
  const tour = document.getElementById("grafo");
  const canvas = root?.querySelector("canvas");
  const hasWebGL = !!document.createElement("canvas").getContext("webgl2");

  if (root && tour && canvas && hasWebGL) {
    const starLabels = [...root.querySelectorAll<HTMLElement>("[data-star]")];
    const constellationLabels = [
      ...root.querySelectorAll<HTMLElement>("[data-constellation-label]"),
    ];
    const { mountGraph } = await import("../scripts/graph");
    mountGraph({
      canvas,
      starLabels,
      constellationLabels,
      totalConstellations: constellationLabels.length,
      stars: starLabels.map((label) => ({
        constellation: Number(label.dataset.constellation),
        brightness: Number(label.dataset.brightness),
        color: label.dataset.color ?? "#ffffff",
      })),
      reducedMotion: matchMedia("(prefers-reduced-motion: reduce)").matches,
      getProgress: () => {
        const rect = tour.getBoundingClientRect();
        return -rect.top / (rect.height - innerHeight);
      },
    });
    root.classList.add("graph-ready");
  }
</script>
