---
// Con dos idiomas basta un enlace al otro: funciona con teclado y en táctil, a diferencia de un menú por hover.
const isSpanish = Astro.currentLocale === "es";
const other = isSpanish
  ? { href: "/", code: "EN", name: "English", lang: "en" }
  : { href: "/es/", code: "ES", name: "Español", lang: "es" };
---

<a
  href={other.href}
  hreflang={other.lang}
  lang={other.lang}
  aria-label={other.name}
  class="flex min-h-11 min-w-11 items-center justify-center rounded-full border border-white/15 px-3 font-mono text-sm text-muted transition hover:border-ember hover:text-paper"
>
  {other.code}
</a>
