---
import LanguageSelector from "@components/LanguageSelector.astro";
import { geti18n } from "@i18n/index";
const { currentLocale } = Astro;
const i18n = geti18n({ currentLocale });
const links = [
  { href: "#grafo", label: i18n.MENU.SKY },
  { href: "#constelaciones", label: i18n.MENU.CONSTELLATIONS },
  { href: "#experiencia", label: i18n.MENU.EXPERIENCE },
  { href: "#contacto", label: i18n.MENU.CONTACT },
];
---

<header id="header-nav" class="fixed top-0 z-50 w-full px-4 py-4 md:px-16">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4">
    <a href="#grafo" class="text-lg font-bold tracking-tight">cristian davila</a>
    <LanguageSelector />
  </div>
</header>

<nav class="dock" aria-label={currentLocale === "es" ? "Menú" : "Menu"}>
  <span class="lens" aria-hidden="true"></span>
  <ul>
    {
      links.map((link, index) => (
        <li>
          <a href={link.href} aria-current={index === 0 ? "true" : "false"}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  #header-nav {
    view-transition-name: site-header;
  }

  /* Dock de cristal líquido: translúcido, con brillo especular arriba y sombra suave debajo. */
  .dock {
    view-transition-name: dock;
    position: fixed;
    z-index: 50;
    left: 50%;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    translate: -50% 0;
    padding: 6px;
    border-radius: 999px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.14), rgb(255 255 255 / 0.04));
    backdrop-filter: blur(14px) saturate(180%) brightness(1.1);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      inset 0 -1px 0 rgb(255 255 255 / 0.08),
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      0 12px 32px -12px rgb(0 0 0 / 0.7);
  }
  /* Reflejo: una luz difusa en la parte superior, como el borde curvo de un cristal. */
  .dock::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(120% 80% at 30% -20%, rgb(255 255 255 / 0.25), transparent 60%);
    mix-blend-mode: screen;
  }
  .dock ul {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 2px;
  }
  .dock a {
    display: block;
    border-radius: 999px;
    padding: 0.6rem 0.7rem;
    font-size: 0.8rem;
    white-space: nowrap;
    color: rgb(242 240 250 / 0.75);
    transition:
      color 0.2s,
      scale 0.25s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .dock a:hover {
    color: var(--color-paper);
    scale: 1.06;
  }
  .dock a[aria-current="true"] {
    color: var(--color-paper);
    anchor-name: --dock-active;
  }
  @media (min-width: 640px) {
    .dock a {
      padding: 0.65rem 1.1rem;
      font-size: 0.875rem;
    }
  }

  /* Lente que se desliza hasta la sección activa: CSS anchor positioning, sin medir nada en JS. */
  .lens {
    position: absolute;
    position-anchor: --dock-active;
    top: anchor(top);
    left: anchor(left);
    width: anchor-size(width);
    height: anchor-size(height);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.16);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.45),
      inset 0 0 12px rgb(255 255 255 / 0.08);
    transition:
      left 0.5s cubic-bezier(0.3, 1.3, 0.5, 1),
      width 0.5s cubic-bezier(0.3, 1.3, 0.5, 1);
  }
  @supports not (anchor-name: --a) {
    .lens {
      display: none;
    }
    .dock a[aria-current="true"] {
      background: rgb(255 255 255 / 0.16);
    }
  }
</style>

<script>
  // Marca en el dock la sección que ocupa el centro de la pantalla.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".dock a")];
  const last = links[links.length - 1];
  // El pie es corto y nunca llega al centro de la pantalla: al tocar fondo, gana Contacto.
  const atBottom = () => innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
  const mark = (hash: string) =>
    links.forEach((link) => link.setAttribute("aria-current", String(link.hash === hash)));

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) mark(atBottom() ? last.hash : `#${entry.target.id}`);
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  links.forEach((link) => {
    const section = document.querySelector(link.hash);
    if (section) observer.observe(section);
  });
  addEventListener("scroll", () => atBottom() && mark(last.hash), { passive: true });
</script>
