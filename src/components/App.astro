---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Experience from "@components/Experience.astro";
import Hero from "@components/Hero.astro";
import Metodo from "@components/Metodo.astro";
import StarCard from "@components/StarCard.astro";
import { geti18n } from "@i18n/index";

const lang = Astro.currentLocale === "es" ? "es" : "en";
const i18n = geti18n({ currentLocale: Astro.currentLocale });
// Cada archivo de src/content/estrellas es una tarjeta; las más destacadas primero.
const cards = (await getCollection("estrellas"))
  .sort((a, b) => b.data.brillo - a.data.brillo || a.id.localeCompare(b.id))
  .map((entry) => ({ id: entry.id, ...entry.data, ...entry.data[lang] }));
---

<Layout
  title={i18n.SEO_TITLE}
  description={i18n.SEO_DESCRIPTION}
  url="https://cristiandavila.dev/"
>
  <main>
    <Hero />
    <Metodo />

    <section id="que-hago" class="mx-auto w-full max-w-6xl px-4 pt-24 md:px-16">
      <p class="mb-3 font-mono text-sm text-muted">{i18n.WHAT.EYEBROW}</p>
      <h2 class="mb-10 text-4xl font-black tracking-[-0.03em] md:text-5xl">{i18n.WHAT.TITLE}</h2>
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          cards.map((card) => (
            <li class="card">
              <StarCard {...card} typeLabel={i18n.WHAT.TYPES[card.tipo]} linkLabel={i18n.WHAT.LINK} />
            </li>
          ))
        }
      </ul>
    </section>

    <section id="experiencia" class="mx-auto w-full max-w-6xl px-4 pt-24 pb-24 md:px-16">
      <p class="mb-3 font-mono text-sm text-muted">{i18n.EXPERIENCE_EYEBROW}</p>
      <h2 class="mb-10 text-4xl font-black tracking-[-0.03em] md:text-5xl">{i18n.EXPERIENCE_TITLE}</h2>
      <Experience />
    </section>
  </main>
</Layout>

<style>
  @supports (animation-timeline: view()) {
    .card {
      animation: rise linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 30%;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 60px;
    }
  }
</style>
