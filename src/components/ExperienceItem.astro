---
interface Props {
  DATE: string;
  TITLE: string;
  DESCRIPTIONS: string[];
  current?: boolean;
}
const { DATE, TITLE, DESCRIPTIONS, current = false } = Astro.props;
---

<div
  class:list={[
    "point absolute mt-1 size-6 rounded-full border-4",
    current ? "border-ink bg-ember" : "border-ink bg-ink",
  ]}
>
</div>
<time class="mb-1 font-mono text-sm text-muted">{DATE}</time>
<h3 class="my-1 text-xl font-black tracking-[-0.02em]">{TITLE}</h3>
{DESCRIPTIONS.map((item) => <p class="mb-1 text-base text-pretty text-muted">{item}</p>)}

<style>
  .point {
    inset-inline-start: -0.9rem;
  }
</style>
