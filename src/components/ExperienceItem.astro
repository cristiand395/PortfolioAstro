---
interface Props {
  DATE: string;
  TITLE: string;
  DESCRIPTIONS: string[];
}
const { DATE, TITLE, DESCRIPTIONS } = Astro.props;
---

<div
  class="point absolute mt-1.5 size-3 rounded-full border-2 border-ink bg-violet"
>
</div>
<time class="mb-1 font-mono text-sm text-muted/80">{DATE}</time>
<h3 class="my-1 text-xl font-semibold text-paper">
  {TITLE}
</h3>
{
  DESCRIPTIONS.map((item) => (
    <p class="mb-1 text-base text-pretty text-muted">{item}</p>
  ))
}

<style>
  .point {
    inset-inline-start: -0.4rem;
  }
</style>
