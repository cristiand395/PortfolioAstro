---
interface Props {
  DATE: string;
  TITLE: string;
  DESCRIPTIONS: string[];
  current?: boolean;
  duration?: string;
}
const { DATE, TITLE, DESCRIPTIONS, current = false, duration } = Astro.props;
---

<div
  class:list={[
    'point absolute mt-1 size-6 rounded-full border-4',
    current ? 'border-ink bg-ember' : 'border-ink bg-ink',
  ]}
></div>
<p class="mb-1 font-mono text-sm text-muted">
  <time>{DATE}</time>
  {duration && (
    <span class="ms-2 rounded-full bg-ink px-2.5 py-0.5 font-extrabold text-white">
      {duration}
    </span>
  )}
</p>
<h3 class="my-1 text-xl font-black tracking-[-0.02em]">{TITLE}</h3>
{DESCRIPTIONS.map((item) => (
  <p class="mb-1 text-base text-pretty text-muted">{item}</p>
))}

<style>
  .point {
    inset-inline-start: -0.9rem;
  }
</style>
