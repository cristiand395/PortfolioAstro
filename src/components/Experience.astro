---
import ExperienceItem from './ExperienceItem.astro';
import { duration } from '../scripts/duracion';

import { geti18n } from '@i18n/index';
const { currentLocale } = Astro;
const i18n = geti18n({ currentLocale });

// shortcut: el puesto actual se calcula al construir la web, así que solo cambia con cada despliegue; basta para años.
const plural = new Intl.PluralRules(currentLocale ?? 'en');
const label = (start: string, end?: string) => {
  const { n, unit } = duration(start, end);
  const forms =
    unit === 'years' ? i18n.EXPERIENCE_YEARS : i18n.EXPERIENCE_MONTHS;
  return (plural.select(n) === 'one' ? forms.one : forms.other).replace(
    '{n}',
    String(n),
  );
};
---

<!-- La experiencia como un riel vertical: el trabajo actual arriba, en naranja. -->
<ol class="relative ml-3 border-s-4 border-rail">
  {i18n.EXPERIENCE_DATA.map((experience, index) => (
    <li class="mb-10 ms-8">
      <ExperienceItem
        {...experience}
        current={index === 0}
        duration={label(
          experience.START,
          'END' in experience ? experience.END : undefined,
        )}
      />
    </li>
  ))}
</ol>
